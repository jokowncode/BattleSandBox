  m_Name: "\u8428\u5C14\u7EF4\u900A\u53F7"
  m_EditorClassIdentifier: 
  ClueName: "\u8428\u5C14\u7EF4\u900A\u53F7"
  Type: 0
  ClueDescription: "2125\u5E74\uFF0C\u4EBA\u7C7B\u5BF9\u80FD\u6E90\u7684\u8FC7\u5EA6\u5F00\u53D1\u5BFC\u81F4\u5927\u9646\u751F\u6001\u5D29\u6E83\uFF0C\u5DE8\u578B\u6E38\u8F6E\u201C\u8428\u5C14\u7EF4\u900A\u53F7\u201D\u6210\u4E3A\u4EBA\u7C7B\u6700\u540E\u7684\u751F\u5B58\u4E4B\u5730\u3002\u7136\u800C\u8239\u4E0A\u7684\u4E00\u5207\u88AB\u72EC\u88C1\u7EC4\u7EC7\u201C\u51C0\u4E16\u4F1A\u201D\u6240\u638C\u63A7\uFF0C\u4ED6\u4EEC\u4EE5\u4EBA\u7C7B\u8FDB\u5316\u4E3A\u540D\uFF0C\u7528\u4EBA\u4F53\u6539\u9020\u836F\u5242\u201CAbbysol\u201D\u5BF9\u5E73\u6C11\u8FDB\u884C\u6B8B\u9177\u7684\u5B9E\u9A8C\uFF0C\u4F01\u56FE\u5236\u9020\u51FA\u66F4\u9AD8\u7EA7\u7684\u201C\u65B0\u4EBA\u7C7B\u201D\u3002\r\n\u51C0\u4E16\u4F1A\u4E3A\u4E86\u8BA9\u8428\u5C14\u7EF4\u900A\u53F7\u5C3D\u53EF\u80FD\u5730\u8FD0\u4F5C\u66F4\u4E45\uFF0C\u5E74\u8F7B\u7684\u52B3\u52A8\u529B\u6210\u4E86\u4ED6\u4EEC\u6700\u6838\u5FC3\u7684\u9700\u6C42\u3002\u4E8E\u662F\uFF0C\u90A3\u4E9B\u8EAB\u5F3A\u529B\u58EE\u6216\u662F\u9AD8\u5B66\u5386\u7684\u9752\u5E74\u4EEC\u5728\u6FC0\u70C8\u7684\u7ADE\u4E89\u4E2D\u5D2D\u9732\u5934\u89D2\uFF0C\u5E26\u7740\u8FDC\u5927\u7684\u5FD7\u5411\u767B\u4E0A\u4E86\u8428\u5C14\u7EF4\u900A\u53F7\u3002\u7136\u800C\u2026\u2026\u8FD9\u7FA4\u5355\u7EAF\u3001\u542C\u8BDD\u7684\u9752\u5E74\u5F55\u5165\u4FE1\u606F\u540E\uFF0C\u88AB\u5B89\u7F6E\u5728\u4E0B\u7B49\u8231\u4E2D\uFF0C\u505A\u7740\u5404\u79CD\u7C7B\u578B\u7684\u810F\u6D3B\u7D2F\u6D3B\u3002\u7B49\u5F85\u4ED6\u4EEC\u7684\u662F\u7269\u8D44\u7D27\u7F3A\u7684\u751F\u5B58\u6761\u4EF6\u3001\u505A\u4E0D\u5B8C\u7684\u5DE5\u4F5C\u548C\u7EDF\u5FA1\u519B\u4E25\u683C\u7684\u76D1\u89C6\uFF0C\u4EE5\u53CA\u2014\u2014\u968F\u65F6\u6210\u4E3A\u201CABBYSOL\u201D\u7684\u5B9E\u9A8C\u4F53\u3002"
