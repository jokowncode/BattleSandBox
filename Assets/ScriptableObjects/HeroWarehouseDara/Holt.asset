  - {fileID: 1606037775, guid: d4f126587b2ffc441a8ef570d6324b9c, type: 3}
  HeroStory: "\u539F\u540D\uFF1A\u0422\u0438\u0445\u043E\u043D \u041C\u0430\u0440\u043A\u043E\u0432 
    \u5409\u6D2A\xB7\u9A6C\u5C14\u79D1\u592B\r\n\u751F\u65E5\uFF1A2095\u5E743\u67086\u65E5\r\n\u6027\u522B\uFF1A\u7537\r\n\u8EAB\u9AD8\uFF1A186cm\r\n\u4F53\u91CD\uFF1A80kg\r\n\u56FD\u7C4D\uFF1A\u4FC4\u7F57\u65AF\r\n\u7231\u597D\uFF1A\u9493\u9C7C
    \u9152\r\n\u4E2A\u6027\uFF1A\u6C89\u9ED8\u5BE1\u8A00 \u52A1\u5B9E\r\n\u8FC7\u5F80\u7ECF\u5386\uFF1A\u9000\u5F79\u519B\u4EBA\r\n\u7CFB\u7EDF\u804C\u52A1\uFF1A\u3010\u5DF2\u6CE8\u9500\u3011\r\n\u6545\u4E8B\u80CC\u666F\uFF1A\u970D\u5C14\u7279\u51FA\u751F\u4E8E\u4FC4\u7F57\u65AF\uFF0C\u6709\u4E00\u6BB5\u5728\u592A\u5E73\u6D0B\u8230\u961F\u670D\u5F79\u7684\u7ECF\u5386\u3002\u767B\u8239\u540E\u4E0D\u5FCD\u770B\u5230\u5404\u56FD\u6C11\u4F17\u906D\u53D7\u51C0\u4E16\u4F1A\u7684\u538B\u8FEB\uFF0C\u970D\u5C14\u7279\u548C\u6218\u53CB\u4EEC\u8054\u5408\u53D1\u8D77\u53CD\u6297\uFF0C\u7ED3\u679C\u53CD\u6297\u5931\u8D25\u540E\u5DE5\u533A\u5168\u5458\u88AB\u4FD8\u3002\u4ED6\u88AB\u4F5C\u4E3A\u201C\u878D\u5408\u5B9E\u9A8C\u201D\u5B9E\u9A8C\u4F53\u5B89\u7F6E\u5728\u4E0B\u5C42\u5173\u62BC\u5BA4\uFF0C\u4E00\u79CD\u53E4\u8001\u6D77\u6D0B\u5BC4\u751F\u751F\u7269\u85E4\u58F6\u611F\u67D3\u4E86\u4ED6\u6FD2\u6B7B\u7684\u8EAB\u4F53\u3002\u6728\u536B\u4E03\u4E0E\u5E03\u6D1B\u514B\u6F5C\u5165\u5173\u62BC\u5BA4\u5C06\u4ED6\u6551\u4E0B\uFF0C\u71B5\u535A\u58EB\u4E3A\u4ED6\u6CBB\u7597\u5E76\u6CE8\u5C04Nexod\uFF0C\u7ADF\u8BA9\u4ED6\u4E0E\u8FD9\u79CD\u5BC4\u751F\u751F\u7269\u8FBE\u6210\u4E86\u60CA\u4EBA\u7684\u5E73\u8861\u4E0E\u878D\u5408\uFF0C\u4F7F\u5176\u6210\u4E3A\u970D\u5C14\u7279\u8EAB\u4F53\u53EF\u63A7\u7684\u4E00\u90E8\u5206\u3002"
  HeroAudios:
  - Audio: {fileID: 8300000, guid: 5de25c4affd62ce4d853646b3bda7106, type: 3}
    AudioContent: "\u54E6\uFF0C\u4E0D\u8981\u6015\uFF0C\u540C\u5FD7\u3002\u8FD9\u662F\u85E4\u58F6\uFF0C\u5B83\u4EEC\u5F88\u542C\u8BDD\u3002"
    OtherLanguageContent: "\u041D\u0435 \u0431\u043E\u0439\u0441\u044F, \u0442\u043E\u0432\u0430\u0440\u0438\u0449.
      \u042D\u0442\u043E \u0440\u0430\u043A\u0443\u0448\u043A\u0438, \u043E\u043D\u0438
      \u043F\u043E\u0441\u043B\u0443\u0448\u043D\u044B\u0435."
  - Audio: {fileID: 8300000, guid: 7630edff08e0aff478fbe98c2962ccd7, type: 3}
    AudioContent: "\u8BA9\u6211\u4EEC\u5F00\u59CB\u9769\u547D\u3002"
    OtherLanguageContent: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043D\u0430\u0447\u043D\u0435\u043C
      \u0440\u0435\u0432\u043E\u043B\u044E\u0446\u0438\u044E."
  - Audio: {fileID: 8300000, guid: 2833ed1adf69e614f80e574e4ab5e648, type: 3}
    AudioContent: "\u591A\u4E8F\u4E86\u8FD9\u4E9B\u5C0F\u5BB6\u4F19\u4EEC\u3002"
    OtherLanguageContent: "\u0412\u0441\u0451 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      \u044D\u0442\u0438\u043C \u043C\u0430\u043B\u044B\u0448\u0430\u043C. "
  - Audio: {fileID: 8300000, guid: c390ccb6a9ebf254d8ab428689a6bc22, type: 3}
    AudioContent: "\u522B\u7070\u5FC3\u2026\u2026\u518D\u6765\u3002"
    OtherLanguageContent: "\u041D\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0439\u0441\u044F\u2026
      \u0415\u0449\u0451 \u0440\u0430\u0437\u043E\u043A! "
