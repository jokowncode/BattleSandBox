  - {fileID: 678291348, guid: 178a6a475937cb1488ad1a8ff7cf7120, type: 3}
  HeroStory: "\u539F\u540D\uFF1A\u307F\u3057\u307E \u308A\u3093 \u4E09\u5C9B\u51DB\r\n\u751F\u65E5\uFF1A2106\u5E746\u67081\u65E5\r\n\u6027\u522B\uFF1A\u5973\r\n\u8EAB\u9AD8\uFF1A158\u339D\r\n\u4F53\u91CD\uFF1A45kg\r\n\u56FD\u7C4D\uFF1A\u65E5\u672C\uFF08\u4E2D\u65E5\u6DF7\u8840\uFF09\r\n\u7231\u597D\uFF1A\uFF08\u672A\u77E5\uFF09\r\n\u4E2A\u6027\uFF1A\u51B7\u6DE1
    \u5B64\u50FB \u4ED7\u4E49\r\n\u8FC7\u5F80\u7ECF\u5386\uFF1A\u523A\u5BA2\r\n\u7CFB\u7EDF\u804C\u52A1\uFF1A\u9AB8\u9AA8\u5E2E-\u6740\u624B\r\n\u6545\u4E8B\u80CC\u666F\uFF1A\u591C\u9611\u7684\u7236\u6BCD\u662F\u65E9\u671F\u201C\u751F\u79D1\u8054\u7EC4\u7EC7\u201D\u7684\u9876\u5C16\u79D1\u5B66\u5BB6\u3002\u751F\u79D1\u8054\u4FDD\u5B88\u6D3E\u79D1\u5B66\u5BB6\u4EEC\u56E0\u53D1\u73B0\u4E86Abyssol\u7684\u5DE8\u5927\u526F\u4F5C\u7528\u5E76\u8BD5\u56FE\u4E0A\u62A5\uFF0C\u89E6\u72AF\u4E86\u9AD8\u5C42\u7684\u5229\u76CA\u3002\u51C0\u4E16\u4F1A\u9AD8\u5C42\u4E0B\u4EE4\u706D\u53E3\uFF0C\u4F46\u770B\u4E2D\u4E86\u591C\u9611\u7684\u5353\u8D8A\u6F5C\u8D28\u3002\u4E8E\u662F\uFF0C\u591C\u9611\u7531\u51C0\u4E16\u4F1A\u7684\u5730\u4E0B\u7EC4\u7EC7\u201C\u9AB8\u9AA8\u5E2E\u201D\u63A5\u624B\u57F9\u517B\uFF0C\u201C\u9AB8\u9AA8\u5E2E\u201D\u6D17\u53BB\u5979\u7684\u8BB0\u5FC6\uFF0C\u5C06\u5176\u8BAD\u7EC3\u6210\u51B7\u6F20\u7684\u523A\u5BA2\uFF0C\u8FD8\u4E0D\u65AD\u7ED9\u5979\u704C\u8F93\u5BF9\u201C\u751F\u79D1\u8054\u4FDD\u5B88\u6D3E\u201D\u7684\u4EC7\u6068\u3002\u591C\u9611\u4E00\u76F4\u5728\u5E95\u5C42\u8239\u8231\u6697\u4E2D\u89C2\u5BDF\uFF0C\u5F88\u5FEB\u5C31\u53D1\u73B0\u4E86\u71B5\u535A\u58EB\u53EF\u80FD\u662F\u6B8B\u7559\u7684\u4FDD\u5B88\u6D3E\uFF0C\u4E8E\u662F\u51B3\u5B9A\u4EE5\u4E00\u5DF1\u4E4B\u529B\u5BF9\u71B5\u535A\u58EB\u884C\u523A\u3002\u523A\u6740\u71B5\u535A\u58EB\u65F6\uFF0C\u5979\u906D\u9047\u4E86\u524D\u6240\u672A\u6709\u7684\u987D\u5F3A\u62B5\u6297\u3002\u6218\u6597\u4E2D\uFF0C\u71B5\u535A\u58EB\u8BA4\u51FA\u4E86\u5979\u3002\u4F17\u4EBA\u5236\u670D\u591C\u9611\u540E\uFF0C\u535A\u58EB\u4E3A\u591C\u9611\u62C6\u9664\u4E86\u8EAB\u4E0A\u7528\u4E8E\u6291\u5236\u8BB0\u5FC6\u548C\u60C5\u611F\u7684\u63A7\u5236\u82AF\u7247\u3002\u6062\u590D\u8BB0\u5FC6\u7684\u591C\u9611\u5F97\u77E5\u7236\u6BCD\u6B7B\u4E8E\u51C0\u4E16\u4F1A\u624B\u4E0A\u540E\u8FD1\u4E4E\u5D29\u6E83\uFF0C\u51B3\u5FC3\u4ECE\u6B64\u4E0E\u71B5\u535A\u58EB\u8054\u5408\uFF0C\u5411\u51C0\u4E16\u4F1A\u590D\u4EC7\u3002"
  HeroAudios:
  - Audio: {fileID: 8300000, guid: fcea2acc3c9128a449310b0e29747d78, type: 3}
    AudioContent: "\u5927\u610F\u8F7B\u654C\u7684\u8BDD\uFF0C\u53EF\u662F\u4F1A\u6B7B\u6389\u7684\u54E6\u3002"
